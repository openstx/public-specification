                <mxCell id="o0cJBMDJHNSw0rVvinLR-115" parent="o0cJBMDJHNSw0rVvinLR-112" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;connectable=0;" value="&lt;div&gt;&lt;b&gt;Executor state&lt;/b&gt;&lt;/div&gt;&lt;div&gt;+ is_idle(): bool&lt;/div&gt;&lt;div&gt;+ get_current_phy_config(): PhyConfig&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Metadata operations:&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;+ get timing requirements&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;(This seems necessary to know if we are still in time to change the packet data)&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;+ get sleeping requirements (for now we ignored this but if we want the core to put the radio to sleep when possible the RAL will have to publish some data about the time to wake up in a standard format)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;RX scheduling&lt;/b&gt;&lt;/div&gt;&lt;div&gt;+ schedule_rx(RxOpParameters): OpHandle&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;+&amp;nbsp;&amp;lt;&amp;lt;optional&amp;gt;&amp;gt;&amp;nbsp;preschedule_rx(rx_at: RadioTime)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Tx handling&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;div&gt;+ schedule_tx(TxOpParameters): OpHandle&lt;/div&gt;+ commit_tx(OpHandle, until: u16):&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;Result&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;+ &amp;lt;&amp;lt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;optional&amp;gt;&amp;gt; commit_tx_and_merge(until: u16,&amp;nbsp;&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;data2: u8[1..MAX], me&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;rge_operation):&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;Result&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;+ &amp;lt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(0, 153, 0);&quot;&gt;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;&amp;lt;optional&amp;gt;&amp;gt; preschedule_tx(tx_at: RadioTime&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;&lt;span style=&quot;color: rgb(103, 171, 159);&quot;&gt;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Other&lt;/b&gt;&lt;/div&gt;&lt;div&gt;+ changePhy(PhyConfig)&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;: &amp;lt;OpHandle? success|error&amp;gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(255, 0, 0);&quot;&gt;+ get_now(): RadioTime&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;b&gt;General operation handling&lt;/b&gt;&lt;br&gt;+ abort_operation(OpHandle):&amp;nbsp;&lt;span style=&quot;color: rgb(255, 51, 51);&quot;&gt;Result&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Obtaining results and state&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;u&gt;Always obtained:&lt;/u&gt;&lt;/div&gt;&lt;div&gt;+ get_status(Handle): OperationStatus&lt;/div&gt;&lt;div&gt;&lt;u&gt;Obtained sometimes:&lt;/u&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;+ get_timestamp(Handle): RadioTime|error&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(255, 0, 0), rgb(255, 0, 0));&quot;&gt;+ carrier_recovery_estimate(OpHandle): int&lt;/s