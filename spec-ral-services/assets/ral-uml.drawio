                <mxCell id="rf-aHFza7QmMruCwgJly-2" parent="o0cJBMDJHNSw0rVvinLR-1" style="rounded=0;whiteSpace=wrap;html=1;spacing=12;align=left;" value="RadioTime provided by&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot; face=&quot;Courier New&quot;&gt;RalExecutor#getNow&lt;/font&gt;" vertex="1">
